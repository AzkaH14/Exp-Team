{
  "name": "mohsyn-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:clean",
    "dev:clean": "pkill -f 'next dev -p 3000' 2>/dev/null || true; pkill -f 'next start' 2>/dev/null || true; rm -rf .next && next dev -p 3000",
    "sync:birthdays": "python3 scripts/sync-hubspot-birthdays.py",
    "sync:birthdays:api": "curl -sS -X POST http://localhost:3000/api/sync/birthdays",
    "sync:notes:api": "curl -sS -X POST http://localhost:3000/api/sync/notes",
    "sync:ticket-notes": "python3 scripts/sync-ticket-insight-notes.py --from-hubspot",
    "sync:ticket-notes:api": "curl -sS -X POST 'http://localhost:3000/api/sync/ticket-notes?refreshTickets=1'",
    "rebuild:analytics": "npx --yes tsx scripts/rebuild-analytics-from-tickets.mjs",
    "sync:hubspot-tickets": "node scripts/sync-hubspot-tickets.mjs",
    "verify:calendar": "node scripts/verify-calendar-sheet.mjs",
    "discover:hubspot-pipelines": "node scripts/discover-hubspot-pipelines.mjs",
    "discover:hubspot-owners": "node scripts/discover-hubspot-owners.mjs",
    "verify:hubspot-engagement": "node scripts/verify-hubspot-engagement.mjs",
    "import:risk-docs": "python3 scripts/import-risk-assessment-birthdays.py",
    "sync:sheet": "python3 scripts/sync-sacred-sheet.py",
    "build": "next build",
    "start": "next start",
    "serve": "npm run build && npm start",
    "lint": "next lint",
    "build:historical": "tsx scripts/build-historical.mjs",
    "check:cutover": "tsx scripts/check-cutover.mjs",
    "check:aggregate": "tsx scripts/check-aggregate.mjs",
    "check:odoo": "tsx --conditions=react-server scripts/check-odoo.mjs",
    "check:unified": "tsx --conditions=react-server scripts/check-unified.mjs",
    "check:all": "npm run check:cutover && npm run check:aggregate && npm run check:odoo && npm run check:unified",
    "bench": "tsx --conditions=react-server scripts/bench-compute.mjs",
    "profile:queue": "tsx --conditions=react-server scripts/profile-queue.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "pdfkit": "^0.19.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
